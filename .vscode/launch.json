{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LoRAIro GUI",
      "type": "debugpy",
      "request": "launch",
      "module": "lorairo.main",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/local_packages/image-annotator-lib/src:${workspaceFolder}/local_packages/genai-tag-db-tools/src"
      },
      "windows": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/local_packages/image-annotator-lib/src;${workspaceFolder}/local_packages/genai-tag-db-tools/src"
        }
      }
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/local_packages/image-annotator-lib/src:${workspaceFolder}/local_packages/genai-tag-db-tools/src"
      },
      "windows": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/local_packages/image-annotator-lib/src;${workspaceFolder}/local_packages/genai-tag-db-tools/src"
        }
      }
    },
    {
      "name": "Python: Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "purpose": [
        "debug-test"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/local_packages/image-annotator-lib/src:${workspaceFolder}/local_packages/genai-tag-db-tools/src",
        "QT_QPA_PLATFORM": "offscreen"
      },
      "windows": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/local_packages/image-annotator-lib/src;${workspaceFolder}/local_packages/genai-tag-db-tools/src",
          "QT_QPA_PLATFORM": "offscreen"
        }
      }
    },
    {
      "name": "Python: gui.widgets",
      "type": "debugpy",
      "request": "launch",
      "module": "lorairo.gui.widgets.${fileBasenameNoExtension}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/local_packages/image-annotator-lib/src:${workspaceFolder}/local_packages/genai-tag-db-tools/src"
      },
      "windows": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/local_packages/image-annotator-lib/src;${workspaceFolder}/local_packages/genai-tag-db-tools/src"
        }
      }
    },
    {
      "name": "Python: gui.window",
      "type": "debugpy",
      "request": "launch",
      "module": "lorairo.gui.window.${fileBasenameNoExtension}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/local_packages/image-annotator-lib/src:${workspaceFolder}/local_packages/genai-tag-db-tools/src"
      },
      "windows": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src;${workspaceFolder}/local_packages/image-annotator-lib/src;${workspaceFolder}/local_packages/genai-tag-db-tools/src"
        }
      }
    }
  ],
  "compounds": [
    {
      "name": "GUI Debug",
      "configurations": [
        "LoRAIro GUI"
      ]
    }
  ]
}
