{
    "name": "LoRAIro Development Environment",
    // VS Code を閉じても agent / 長時間ジョブを止めない
    "shutdownAction": "none",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "TZ": "${localEnv:TZ:UTC}"
        }
    },
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt",
        "seccomp=unconfined",
        "-p",
        "2222:22",
        "--add-host=host.docker.internal:host-gateway"
    ],
    // 複数の Devcontainer がある場合、プロジェクトごとにこのポート番号を変える
    "forwardPorts": [2222],
    // host checkout を rw で共有する。worktree は .agents/worktree/ 配下に OS ごとに作る
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/LoRAIro,type=bind",
    "workspaceFolder": "/workspaces/LoRAIro",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.mypy-type-checker",
                "charliermarsh.ruff",
                "kawamataryo.copy-python-dotted-path",
                "qwtel.sqlite-viewer",
                "tamasfe.even-better-toml",
                "mechatroner.rainbow-csv",
                "eamodio.gitlens",
                "donjayamanne.git-extension-pack",
                "streetsidesoftware.code-spell-checker",
                "vscode-icons-team.vscode-icons",
                "shardulm94.trailing-spaces",
                "gruntfuggly.todo-tree",
                "intellsmi.comment-translate",
                "CucumberOpen.cucumber-official",
                "wscats.search",
                "esbenp.prettier-vscode",
                "masakit.zenkaku-hankaku"
            ]
        }
    },
    "overrideCommand":true,
    "remoteUser": "vscode",
    "remoteEnv": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "UV_PROJECT_ENVIRONMENT": "/workspaces/LoRAIro/.venv",
        "QT_QPA_PLATFORM": "offscreen",
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "CODEX_HOME": "/home/vscode/.codex",
        "GIT_CONFIG_GLOBAL": "/home/vscode/.config/git/config",
        "PYTHONDONTWRITEBYTECODE": "1"
    },
    "mounts": [
        "source=lorairo-bashhistory,target=/home/vscode/.bash_history,type=volume",
        "source=lorairo-vscode-extensions,target=/home/vscode/.vscode-server/extensions,type=volume",
        "source=lorairo-venv,target=/workspaces/LoRAIro/.venv,type=volume",
        "source=lorairo-claude-config,target=/home/vscode/.claude,type=volume",
        "source=lorairo-codex-config,target=/home/vscode/.codex,type=volume",
        "source=lorairo-linux-config,target=/home/vscode/.config,type=volume",
        "source=lorairo-linux-cache,target=/home/vscode/.cache,type=volume",
        "source=lorairo-linux-state,target=/home/vscode/.local/state,type=volume",
        "source=lorairo-worktrees,target=/tmp/worktrees,type=volume"
    ],
    "postCreateCommand": "bash /workspaces/LoRAIro/.devcontainer/postCreateCommand.sh",
    "postAttachCommand": {},
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {
        "version": "latest",
        "ports": "22",
        "passwordAccess": "disabled"
        }
    }
}
