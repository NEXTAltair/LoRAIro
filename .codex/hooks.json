{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import pathlib,runpy,subprocess,sys; p=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,encoding='utf-8').strip())/'.codex/hooks/hook_pre_commands.py'; sys.path.insert(0,str(p.parent)); runpy.run_path(str(p),run_name='__main__')\"",
            "commandWindows": "python -X utf8 -c \"import pathlib,runpy,subprocess,sys; p=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,encoding='utf-8').strip())/'.codex/hooks/hook_pre_commands.py'; sys.path.insert(0,str(p.parent)); runpy.run_path(str(p),run_name='__main__')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 -c \"import pathlib,runpy,subprocess,sys; p=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,encoding='utf-8').strip())/'.codex/hooks/hook_response_monitor.py'; sys.path.insert(0,str(p.parent)); runpy.run_path(str(p),run_name='__main__')\"",
            "commandWindows": "python -X utf8 -c \"import pathlib,runpy,subprocess,sys; p=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True,encoding='utf-8').strip())/'.codex/hooks/hook_response_monitor.py'; sys.path.insert(0,str(p.parent)); runpy.run_path(str(p),run_name='__main__')\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
